# ===== PAPLOY.AI Configuration =====

# Your OpenAI API Key (required)
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI API Base URL (change this to use a different provider)
OPENAI_BASE_URL=https://api.openai.com/v1

# AI Model to use
AI_MODEL=gpt-3.5-turbo

# The name of your AI assistant (shown in the UI and system prompt)
AI_NAME=PAPLOY.AI

# Port the server runs on
PORT=3000

# Max messages per session history (to control token usage)
MAX_HISTORY=30
